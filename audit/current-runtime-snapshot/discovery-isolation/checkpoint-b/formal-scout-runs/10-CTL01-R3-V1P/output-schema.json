{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "readerlab.discovery-isolation.scout-v1-prime-response.v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["trigger_map", "seed_batch"],
  "properties": {
    "trigger_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "triggers"],
      "properties": {
        "schema_version": {"type": "string", "const": "trigger-map.v0.1"},
        "triggers": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trigger_id", "source_anchor_quote_en", "unexplained_relation_zh", "possible_missing_variable_zh"],
            "properties": {
              "trigger_id": {"type": "string", "pattern": "^T[1-6]$"},
              "source_anchor_quote_en": {"type": "string", "minLength": 1, "maxLength": 500},
              "unexplained_relation_zh": {"type": "string", "minLength": 1, "maxLength": 240},
              "possible_missing_variable_zh": {"type": ["string", "null"], "maxLength": 160}
            }
          }
        }
      }
    },
    "seed_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "seeds"],
      "properties": {
        "schema_version": {"type": "string", "const": "seed-batch.v0.1"},
        "run_id": {"type": "string", "minLength": 1},
        "seeds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["seed_id", "source_anchor_quote_en", "external_lens_identity", "mechanism_claim_zh", "reread_delta_zh", "source_leads"],
            "properties": {
              "seed_id": {"type": "string", "pattern": "^S[1-6]$"},
              "source_anchor_quote_en": {"type": "string", "minLength": 1, "maxLength": 500},
              "external_lens_identity": {"type": "string", "minLength": 1, "maxLength": 160},
              "mechanism_claim_zh": {"type": "string", "minLength": 1, "maxLength": 240},
              "reread_delta_zh": {"type": "string", "minLength": 1, "maxLength": 180},
              "source_leads": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {"type": "string", "minLength": 1, "maxLength": 240}
              }
            }
          }
        }
      }
    }
  }
}
