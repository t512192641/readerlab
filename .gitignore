# macOS metadata must stay out of every run/archive nesting level.
.DS_Store

# Historical run payloads stay local by default. Git keeps only compact
# control evidence; already tracked historical files remain tracked.
runs/*/**
!runs/*/**/
!runs/*/run.json
!runs/*/production-freeze.json
!runs/*/*receipt*.json
!runs/*/*receipt*.md
!runs/*/receipts/*.json
!runs/*/receipts/*.md
!runs/*/control/*manifest*.json
!runs/*/control/*manifest*.md
!runs/*/control/*registry*.jsonl
!runs/*/control/*ledger*.jsonl
!runs/*/control/*gate*.md
!runs/*/control/*gate*.txt
!runs/*/control/p2-recovery-*.json
!runs/*/locked/*gate*.md
!runs/*/acceptance/acceptance-freeze.json
!runs/*/acceptance/*verdict*.md
!runs/*/review/companion-v01.md
!runs/*/review/*summary*.md
!runs/*/review/*ledger*.md

# The same evidence-only policy applies after a run moves into the archive.
archive/*/**
!archive/*/**/
!archive/*/run.json
!archive/*/production-freeze.json
!archive/*/*receipt*.json
!archive/*/*receipt*.md
!archive/*/receipts/*.json
!archive/*/receipts/*.md
!archive/*/control/*manifest*.json
!archive/*/control/*manifest*.md
!archive/*/control/*registry*.jsonl
!archive/*/control/*ledger*.jsonl
!archive/*/control/*gate*.md
!archive/*/control/*gate*.txt
!archive/*/control/p2-recovery-*.json
!archive/*/locked/*gate*.md
!archive/*/acceptance/acceptance-freeze.json
!archive/*/acceptance/*verdict*.md
!archive/*/review/companion-v01.md
!archive/*/review/*summary*.md
!archive/*/review/*ledger*.md
